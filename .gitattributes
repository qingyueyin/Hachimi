# Auto-detect text files and perform newline normalization
* text=auto eol=lf

# Source code - LF line endings
*.kt text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.gradle.kts text eol=lf
*.kts text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Shell scripts - LF
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary files - no text conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svg binary
*.ico binary
*.aab binary
*.apk binary
*.aar binary
*.so binary
*.class binary
*.jar binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary

# ProGuard/R8 - keep as text
*.pro text eol=lf
